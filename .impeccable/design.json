  "components": [
    {
      "name": "Search action",
      "kind": "button",
      "refersTo": "search-button",
      "description": "Circular submit action; enabled only for a valid non-composing query.",
      "html": "<button class=\"ds-search-button\" aria-label=\"Search Google\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M5 12h14m-6-6 6 6-6 6\"/></svg></button>",
      "css": ".ds-search-button{font-family:Geist,Arial,sans-serif;width:44px;height:44px;border:0;border-radius:50%;background:#1a73e8;color:white;display:flex;align-items:center;justify-content:center;cursor:pointer;transition:background .15s,transform .15s}.ds-search-button:hover{background:#1559bc}.ds-search-button:active{transform:scale(.94)}.ds-search-button:disabled{background:#f1f3f4;color:#81868d;cursor:default}.ds-search-button:focus-visible,.ds-input:focus-visible,.ds-choice:focus-visible,.ds-nav button:focus-visible,.ds-chip:focus-visible,.ds-example:focus-visible{outline:3px solid #8ab4f8;outline-offset:3px}"
    },
    {
      "name": "Tool input",
      "kind": "input",
      "refersTo": "input",
      "description": "White editable field inside a tinted tool.",
      "html": "<label style=\"font:11px Geist,Arial,sans-serif;color:#59616c\">Website domain<input class=\"ds-input\" placeholder=\"example.com\" aria-label=\"Website domain\"></label>",
      "css": ".ds-input{font-family:Geist,Arial,sans-serif;display:block;margin-top:8px;background:#fff;border:1px solid color-mix(in srgb,var(--accent,#1967d2) 20%,white);color:var(--ink,#202124);border-radius:8px;padding:11px;font-size:13px;min-height:44px;box-sizing:border-box}.ds-search-button:focus-visible,.ds-input:focus-visible,.ds-choice:focus-visible,.ds-nav button:focus-visible,.ds-chip:focus-visible,.ds-example:focus-visible{outline:3px solid #8ab4f8;outline-offset:3px}"
    },
    {
      "name": "Tool choices",
      "kind": "button",
      "description": "Pressed choices use the current tool accent.",
      "html": "<div class=\"ds-choices\" role=\"group\" aria-label=\"Forecast period\"><button class=\"ds-choice\" aria-pressed=\"true\">Today</button><button class=\"ds-choice\" aria-pressed=\"false\">Tomorrow</button></div>",
      "css": ".ds-choices{display:flex;flex-wrap:wrap;gap:6px;padding:8px;background:var(--tint,#f5f8ff)}.ds-choice{font-family:Geist,Arial,sans-serif;min-height:44px;min-width:44px;font-size:11px;border:1px solid color-mix(in srgb,var(--accent,#1967d2) 15%,white);border-radius:8px;padding:8px 12px;background:#ffffff70;color:var(--ink,#202124);cursor:pointer;transition:background .15s,color .15s}.ds-choice[aria-pressed=true]{background:var(--accent,#1967d2);color:white;border-color:var(--accent,#1967d2)}.ds-choice:hover:not([aria-pressed=true]){background:white}.ds-search-button:focus-visible,.ds-input:focus-visible,.ds-choice:focus-visible,.ds-nav button:focus-visible,.ds-chip:focus-visible,.ds-example:focus-visible{outline:3px solid #8ab4f8;outline-offset:3px}"
    },
    {
      "name": "Classic / Fluid switch",
      "kind": "nav",
      "description": "Compact comparison switch with a lifted active segment.",
      "html": "<div class=\"ds-nav\" role=\"group\" aria-label=\"Search interface\"><button aria-pressed=\"false\">Classic</button><button aria-pressed=\"true\">Fluid</button></div>",
      "css": ".ds-nav{display:inline-flex;background:#f3f4f5;border:1px solid #e9eaec;border-radius:24px;padding:3px}.ds-nav button{font-family:Geist,Arial,sans-serif;border:0;background:none;color:#202124;min-width:66px;height:44px;border-radius:20px;font-size:12px;cursor:pointer;transition:background .15s,color .15s,box-shadow .15s}.ds-nav button[aria-pressed=true]{background:white;color:#174ea6;box-shadow:0 2px 5px #20212412}.ds-nav button:hover{color:#174ea6}.ds-search-button:focus-visible,.ds-input:focus-visible,.ds-choice:focus-visible,.ds-nav button:focus-visible,.ds-chip:focus-visible,.ds-example:focus-visible{outline:3px solid #8ab4f8;outline-offset:3px}"
    },
    {
      "name": "Search filter chip",
      "kind": "chip",
      "description": "Removable syntax token with a full touch target.",
      "html": "<button class=\"ds-chip\" aria-label=\"Remove Website: example.com\"><span>Website: example.com</span><svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"m18 6-12 12M6 6l12 12\"/></svg></button>",
      "css": ".ds-chip{font-family:Geist,Arial,sans-serif;display:flex;align-items:center;gap:7px;min-height:44px;min-width:44px;background:#fff9;border:1px solid color-mix(in srgb,var(--accent,#1967d2) 18%,white);border-radius:7px;color:var(--accent,#1967d2);font-size:11px;padding:8px 10px;text-align:left;cursor:pointer}.ds-chip span{overflow-wrap:anywhere}.ds-chip:hover{background:white}.ds-search-button:focus-visible,.ds-input:focus-visible,.ds-choice:focus-visible,.ds-nav button:focus-visible,.ds-chip:focus-visible,.ds-example:focus-visible{outline:3px solid #8ab4f8;outline-offset:3px}"
