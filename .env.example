# All values are server-only. Never prefix these names with NEXT_PUBLIC_.
# Copy to .env.local for local development; do not commit the populated file.
LIVE_INFERENCE_ENABLED=false

# TypeSafe account API key. Uses the launch allowance shared by all visitors.
TYPESAFE_API_KEY=

# Existing Supabase Free project; apply the included SQL migration first.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# A random secret of at least 32 characters used for daily HMAC rate-limit IDs.
RATE_LIMIT_SECRET=
